# Prompt before actions that can publish, deploy, mutate infrastructure, or affect shared history.
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Pushing changes requires explicit user permission.",
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "prompt",
    justification = "Merging a pull request requires explicit user permission.",
)

prefix_rule(
    pattern = ["npm", "publish"],
    decision = "prompt",
    justification = "Package publishing is an external irreversible action.",
)

prefix_rule(
    pattern = ["pnpm", "publish"],
    decision = "prompt",
    justification = "Package publishing is an external irreversible action.",
)

prefix_rule(
    pattern = ["twine", "upload"],
    decision = "prompt",
    justification = "Package publishing is an external irreversible action.",
)

prefix_rule(
    pattern = ["vercel", "deploy"],
    decision = "prompt",
    justification = "Deployment requires explicit user permission.",
)

prefix_rule(
    pattern = ["vercel", "--prod"],
    decision = "prompt",
    justification = "Production deployment requires explicit user permission.",
)

prefix_rule(
    pattern = ["supabase", "db", "push"],
    decision = "prompt",
    justification = "Remote database mutation requires explicit user permission.",
)

prefix_rule(
    pattern = ["supabase", "functions", "deploy"],
    decision = "prompt",
    justification = "Remote deployment requires explicit user permission.",
)

prefix_rule(
    pattern = ["terraform", "apply"],
    decision = "prompt",
    justification = "Infrastructure mutation requires explicit user permission.",
)

prefix_rule(
    pattern = ["terraform", "destroy"],
    decision = "forbidden",
    justification = "Infrastructure destruction is blocked by default.",
)

prefix_rule(
    pattern = ["kubectl", "delete"],
    decision = "prompt",
    justification = "Cluster deletion requires explicit user permission.",
)

prefix_rule(
    pattern = ["docker", "system", "prune"],
    decision = "prompt",
    justification = "Pruning can remove important local data.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset can destroy uncommitted work.",
)

prefix_rule(
    pattern = ["git", "clean", "-fd"],
    decision = "forbidden",
    justification = "Git clean can permanently delete untracked files.",
)
