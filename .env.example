# Copy to .env and fill values locally. Never commit real secrets.
# Supabase Cloud is intentionally not configured during Phase 0.
APP_ENV=development

# Public web configuration. Leave Supabase values empty until a local project exists.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public mobile configuration. Leave Supabase values empty until a local project exists.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
