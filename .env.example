# Optional shared public local settings. Never commit real secrets.
# Use only the local Supabase API URL and publishable/anon key; do not add a service-role key.
APP_ENV=development

# Public web configuration. Leave blank until the local Supabase stack is running.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public mobile configuration. Leave blank until the local Supabase stack is running.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
