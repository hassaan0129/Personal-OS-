{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"D:\\Hassaan\\Projects\\personal-os\\.codex\\hooks\\pre_tool_policy.py\"",
            "commandWindows": "python \"D:\\Hassaan\\Projects\\personal-os\\.codex\\hooks\\pre_tool_policy.py\"",
            "timeout": 30,
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"D:\\Hassaan\\Projects\\personal-os\\.codex\\hooks\\post_tool_secret_scan.py\"",
            "commandWindows": "python \"D:\\Hassaan\\Projects\\personal-os\\.codex\\hooks\\post_tool_secret_scan.py\"",
            "timeout": 45,
            "statusMessage": "Scanning changed files for secrets"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"D:\\Hassaan\\Projects\\personal-os\\.codex\\hooks\\stop_verify.py\"",
            "commandWindows": "python \"D:\\Hassaan\\Projects\\personal-os\\.codex\\hooks\\stop_verify.py\"",
            "timeout": 930,
            "statusMessage": "Running final project verification"
          }
        ]
      }
    ]
  }
}